PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/taskhub

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL (OAuth redirect, CORS and links inside emails)
FRONTEND_URL=http://localhost:5173

# ---------- Access ----------
# The app is invite-only. These emails can always sign in and become
# Super Admin on first sign-in (comma separated). Everyone else needs an invite.
SUPERADMIN_EMAIL=you@yourcompany.com

# ---------- Google login ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
# Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------- Email ----------
# Pick one provider. If EMAIL_PROVIDER is empty, the first one with credentials
# is used (resend > brevo > smtp). With none set, emails are skipped.
EMAIL_PROVIDER=
# Sender shown in the inbox. Must be a domain/sender verified with your provider.
EMAIL_FROM="Tasks Manager <info@oncarecancer.com>"

# Option A: Resend HTTP API (https://resend.com -> API Keys)
RESEND_API_KEY=

# Option B: Brevo HTTP API (https://app.brevo.com -> SMTP & API -> API Keys)
BREVO_API_KEY=

# Option C: SMTP (Gmail needs an App Password, not your normal password).
# Gmail sends as SMTP_USER; to show no-reply@ the address must be a verified alias in Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Option D: Gmail / Workspace via Nodemailer + OAuth2 (EMAIL_PROVIDER=gmail).
# SMTP_USER is the sending account (e.g. info@oncarecancer.com); leave SMTP_PASS empty.
# Client id/secret: Google Cloud -> Credentials -> OAuth client (Web), redirect
# https://developers.google.com/oauthplayground. Refresh token: OAuth Playground,
# scope https://mail.google.com/, signed in as SMTP_USER. Set the consent screen to
# Internal, otherwise the token expires after 7 days.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Logo shown in emails (must be a public URL)
EMAIL_LOGO_URL=https://www.oncarecancer.com/images/favicon.png
